<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\ChoETL.Build.props" />

  <PropertyGroup>
    <Version>1.0.1.36</Version>
    <Authors>Cinchoo</Authors>
    <Company>Cinchoo Inc.</Company>
    <Description>Parquet extension to Cinchoo ETL framework</Description>
    <Copyright>Copyright Cinchoo Inc.</Copyright>
    <PackageProjectUrl>https://github.com/Cinchoo/ChoETL</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Cinchoo/ChoETL</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ETL c# .NET CSV Xml JSON Flat Parquet Yaml</PackageTags>
    <PackageReleaseNotes>.NET Standard version</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>ChoETL.Parquet.snk</AssemblyOriginatorKeyFile>
    <PackageIcon>cinchoo.png</PackageIcon>
      <TargetFrameworks>$(ChoETLTargetFrameworks)</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="$(ChoETLNewtonsoftJsonVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Parquet.Net" Version="4.25.0" />
    <!-- IronCompress (a Parquet.Net 4.x dependency) pulls in Snappier 1.1.1, which has a known vulnerability (#331). -->
    <PackageReference Include="Snappier" Version="1.3.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChoETL.NETStandard\ChoETL.NETStandard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Assets\Icons\cinchoo.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
